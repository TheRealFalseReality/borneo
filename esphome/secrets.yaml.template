# ESPHome Secrets Template
# Copy this file to secrets.yaml and fill in your own values

# WiFi credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback AP password
ap_password: "YourFallbackPassword"

# API encryption key (generate with: esphome encryption-key-generate)
api_encryption_key: "your_32_character_encryption_key"

# OTA password
ota_password: "YourOTAPassword"

# Location for sunrise/sunset calculation
latitude: "0.0"  # Your latitude
longitude: "0.0"  # Your longitude

# Optional: MQTT broker settings
# mqtt_broker: "homeassistant.local"
# mqtt_username: "mqtt_user"
# mqtt_password: "mqtt_password"
